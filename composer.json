{
    "name": "cms-provenance/provenance",
    "type": "typo3-cms-extension",
    "description": "Machine-readable provenance records for pages and content elements, emitted as JSON-LD.",
    "license": "GPL-2.0-or-later",
    "homepage": "https://cms-provenance.org",
    "keywords": [
        "TYPO3",
        "extension",
        "provenance",
        "content-provenance",
        "json-ld"
    ],
    "support": {
        "issues": "https://github.com/dkd-dobberkau/typo3-provenance/issues",
        "source": "https://github.com/dkd-dobberkau/typo3-provenance"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.0"
    },
    "require-dev": {
        "typo3/testing-framework": "^9.7",
        "typo3/cms-frontend": "^13.4 || ^14.0",
        "typo3/cms-fluid": "^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "CmsProvenance\\Provenance\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CmsProvenance\\Provenance\\Tests\\": "Tests/",
            "CmsProvenance\\TestWellKnown\\": "Tests/Functional/WellKnown/Fixtures/Extensions/test_wellknown/Classes/"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "provenance",
            "web-dir": ".Build/public",
            "version": "0.0.0",
            "Package": {
                "providesPackages": {}
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "test": [
            "@test:unit",
            "@test:functional"
        ]
    }
}
